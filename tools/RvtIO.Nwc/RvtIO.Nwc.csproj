<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(NwcIOProject)' != ''">
    <DefineConstants>$(DefineConstants);MANAGED_NWC</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RvtIO.Scene\RvtIO.Scene.csproj" />
    <PackageReference Include="NwcIO" Condition="'$(NwcIOProject)' == ''" />
    <ProjectReference Include="$(NwcIOProject)" Condition="'$(NwcIOProject)' != ''" />
    <InternalsVisibleTo Include="RvtIO.Tests" />
  </ItemGroup>

</Project>
